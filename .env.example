BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REGION=eu
WOW_REALM_SLUGS=

# Optional. Without these the pipeline runs in local mode:
# SQLite stays in data/ and published JSON goes to data/public/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=coinwarden

# Local addon sync only (core/addon_sync.py). Same value as the Worker's
# LEDGER_WRITE_TOKEN binding - it gates writes to /api/game/state and
# /api/game/events the same way it gates the ledger.
COINWARDEN_SYNC_TOKEN=
COINWARDEN_DASHBOARD_URL=https://coinwarden.epe-michel.workers.dev
# Optional: exact path to the addon's SavedVariables file. Auto-discovered
# under the default WoW install location if unset.
COINWARDEN_ADDON_SAVEDVARS=
